# Runtime-only image for the CommunityMP dedicated server.
# The binary and its CoreScripts tree are built by .github/workflows/server-image.yml
# and staged in ./stage before this Dockerfile is used -- nothing is compiled here.
FROM ubuntu:24.04

RUN apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends software-properties-common ca-certificates \
    && add-apt-repository -y ppa:openmw/openmw \
    && apt-get -o Acquire::Retries=5 update

COPY stage/runtime-deps.txt /tmp/runtime-deps.txt

# install exactly the packages that own the shared libraries the binary links
RUN apt-get -o Acquire::Retries=5 install -y --no-install-recommends $(tr '\n' ' ' < /tmp/runtime-deps.txt) \
    && apt-get purge -y software-properties-common \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* /tmp/runtime-deps.txt

WORKDIR /opt/communitymp
COPY stage/communitymp-server            /opt/communitymp/communitymp-server
COPY stage/communitymp-server-default.cfg /opt/communitymp/communitymp-server-default.cfg
COPY stage/server                         /opt/communitymp/server
COPY stage/COMMIT                         /opt/communitymp/COMMIT

EXPOSE 25565/udp
ENTRYPOINT ["/opt/communitymp/communitymp-server"]
