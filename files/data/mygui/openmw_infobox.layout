<MyGUI type="Layout">
    <Widget type="Window" skin="MW_Dialog" layer="Modal" position="0 0 680 330" align="Center" name="_Main">

        <Widget type="Widget" skin="MW_Box" position="30 24 620 92" name="TextBox" align="Top HCenter">
