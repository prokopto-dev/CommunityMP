<?xml version="1.0" encoding="UTF-8"?>

<MyGUI type="Layout">
    <Widget type="Window" skin="MW_Dialog" layer="Modal" position="0 0 900 560" align="Center" name="_Main">
        <Widget type="TextBox" skin="HeaderText" position="32 24 836 28" name="DescriptionTitle" align="Left Top">
