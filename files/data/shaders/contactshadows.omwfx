uniform_int uSteps {
    default = 38;
    min = 8;
    max = 128;
    step = 1;
    display_name = "Contact Shadow Steps";
    description = "Per-pixel raymarch steps. Higher = smoother / longer shadows, slower.";
}

uniform_float uLength {
    default = 0.05;
    min = 0.01;
    max = 0.5;
    step = 0.005;
    display_name = "Length";
    description = "World-space ray length toward the sun (×600 MW units). Longer rays = bigger shadow footprint, more banding at the same step count.";
}

uniform_float uThickness {
    default = 0.025;
    min = 0.005;
    max = 0.1;
    step = 0.001;
    display_name = "Thickness";
    description = "Depth-difference window that counts as an occluder. Lower = thinner / less false-positives at silhouettes; higher = catches finer features at the cost of edge artefacts.";
}

uniform_float uStrength {
    default = 0.7;
    min = 0.0;
    max = 1.0;
    step = 0.05;
    display_name = "Strength";
    description = "Final darkening on occluded pixels. 1.0 = pure black on hit, 0.0 = effect off.";
}

uniform_float uBias {
    default = 4.0;
    min = 0.0;
    max = 20.0;
    step = 0.5;
    display_name = "Surface Bias";
    description = "Distance (in MW units) the ray origin is pushed along the surface normal before marching. Prevents self-shadow at glancing angles.";
}

uniform_float uPenumbraSoftness {
    default = 1.0;
    min = 0.0;
    max = 4.0;
    step = 0.1;
    display_name = "Penumbra Softness";
    description = "Distance-based soft-shadow ramp. 0 = hard binary shadow (occluded or not). Higher = occluders far down the ray cast progressively softer shadows, mimicking the sun's angular size.";
}

uniform_float uStepCurve {
    default = 1.5;
    min = 1.0;
    max = 3.0;
    step = 0.1;
    display_name = "Step Curve";
    description = "Logarithmic step distribution along the ray. 1 = uniform (every sample equally spaced), >1 concentrates samples close to the surface where the shadow detail is, leaving fewer samples for the far end where banding is invisible anyway.";
}

uniform_bool uBilateralBlur {
    default = true;
    display_name = "Bilateral Blur";
    description = "Apply a depth-aware 5x5 cross blur to the raw shadow buffer to smooth out raymarche noise without bleeding across silhouettes.";
}

uniform_float uBlurDepthSigma {
    default = 30.0;
    min = 1.0;
    max = 200.0;
    step = 1.0;
    display_name = "Blur Depth Threshold";
    description = "View-space depth (units) over which the blur weight falls off — keeps shadows from leaking across geometric edges.";
}

uniform_bool uFadeWithSun {
    default = true;
    display_name = "Fade With Sun Visibility";
    description = "Multiply the effect by omw.sunVis so the shadow softens when clouds occlude the sun and disappears at night.";
}

uniform_bool uDebugView {
    default = false;
    display_name = "Debug: Show Raw Shadow Buffer";
    description = "Replace the screen with a greyscale dump of the contact-shadow buffer. White = no shadow, dark = shadow. Useful to verify whether the raymarche fires at all on a given pixel.";
}

uniform_bool uPointLights {
    default = true;
    display_name = "Point-Light Contact Shadows";
    description = "Cast extra contact shadows from active dynamic point lights (torches, spells, lanterns). Heavy — gated by uMaxLights and uLightSteps.";
}

uniform_int uMaxLights {
    default = 4;
    min = 1;
    max = 8;
    step = 1;
    display_name = "Max Lights Per Pixel";
    description = "Hard cap on the number of point lights that contribute to the contact shadow per fragment. LightManager already sorts by distance, so the closest N are used.";
}

uniform_int uLightSteps {
    default = 16;
    min = 6;
    max = 32;
    step = 1;
    display_name = "Steps Per Light";
    description = "Raymarch step count per point light. Lower than the sun's steps because point-light rays are short (capped by light radius).";
}

uniform_float uLightStrength {
    default = 0.6;
    min = 0.0;
    max = 1.0;
    step = 0.05;
    display_name = "Point-Light Strength";
    description = "Per-light occlusion weight. Final shadow accumulates over all lights then clamps to [0,1] before multiplying with the sun shadow.";
}

uniform_float uLightLengthScale {
    default = 0.6;
    min = 0.1;
    max = 1.0;
    step = 0.05;
    display_name = "Light Ray Length";
    description = "Fraction of the light's radius the ray actually marches. Shorter rays = fewer false hits behind the occluder, less banding for the same step count.";
}

uniform_bool uLightFacingOnly {
    default = true;
    display_name = "Skip Back-Facing Lights";
    description = "Don't trace lights illuminating the back of the surface (dot(N, lightDir) <= 0). Saves perf and avoids spurious shadows.";
}

shared {
    vec3 viewPosFromUV(vec2 uv)
    {
        float d = omw_GetDepth(uv);
#if (OMW_REVERSE_Z == 1)
        float ndcZ = 1.0 - d;
#else
        float ndcZ = d * 2.0 - 1.0;
#endif
        vec4 ndc = vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
        vec4 view = omw_InvProjectionMatrix() * ndc;
        return view.xyz / view.w;
    }

    // Per-fragment shadow contribution from active point lights.
    // originVS / normalVS are view-space, originWS is world-space (already
    // computed by the caller, passed in to avoid recomputing the inverse
    // view matrix multiplication).
    float pointLightShadow(vec3 originVS, vec3 normalVS, vec3 originWS,
                           float thickness, float minThickness)
    {
        if (!uPointLights)
            return 1.0;
        int n = omw_GetPointLightCount();
        if (n <= 0)
            return 1.0;
        // Engine sorts lights by view-space distance, so the first N are
        // the closest — capping is just a slice.
        n = min(n, uMaxLights);

        float occlusion = 0.0;
        for (int li = 0; li < n; ++li)
        {
            vec3 lightWS = omw_GetPointLightWorldPos(li);
            float radius = omw_GetPointLightRadius(li);
            vec3 toLightWS = lightWS - originWS;
            float distWS = length(toLightWS);
            // Outside the light's radius — no influence, no shadow.
            if (distWS > radius || distWS < 1.0)
                continue;

            // To view space.
            vec3 lightVS = (omw.viewMatrix * vec4(lightWS, 1.0)).xyz;
            vec3 dirVS = lightVS - originVS;
            float distVS = length(dirVS);
            if (distVS < 1.0)
                continue;
            dirVS /= distVS;

            // Skip back-facing surfaces — light can't reach them, so a
            // contact shadow there would be wrong (and wastes ~16 samples).
            if (uLightFacingOnly && dot(normalVS, dirVS) <= 0.0)
                continue;

            // March length: bounded by both the actual distance to the
            // light and a fraction of its radius. The fraction lets the
            // user trade detail vs. banding.
            float marchLen = min(distVS, radius * uLightLengthScale);
            if (marchLen < 2.0)
                continue;

            vec3 endVS = originVS + dirVS * marchLen;
            vec4 clipS = omw_ProjectionMatrix() * vec4(originVS, 1.0);
            vec4 clipE = omw_ProjectionMatrix() * vec4(endVS, 1.0);
            vec2 ssStart = (clipS.xy / clipS.w) * 0.5 + 0.5;
            vec2 ssEnd   = (clipE.xy / clipE.w) * 0.5 + 0.5;
            vec2 delta = ssEnd - ssStart;

            // Light-anchored dither — different offset per light so the
            // noise patterns don't stack into a coherent banding artefact.
            float dither = fract(sin(dot(originWS + lightWS,
                vec3(12.9898, 78.233, 37.719))) * 43758.5453);

            // Light contribution weight: distance falloff (smoothstepped
            // out near the radius) × diffuse luminance (so a bright torch
            // contributes more than a faint candle).
            float distFalloff = 1.0 - smoothstep(radius * 0.5, radius, distWS);
            vec3 diffuse = omw_GetPointLightDiffuse(li);
            float lum = dot(diffuse, vec3(0.299, 0.587, 0.114));
            float weight = distFalloff * clamp(lum, 0.0, 1.0);
            if (weight < 0.01)
                continue;

            int lsteps = uLightSteps;
            float hitT = 1.0;
            float lightOccluded = 0.0;
            for (int s = 1; s <= lsteps; ++s)
            {
                float linT = (float(s) + dither) / float(lsteps);
                float t = pow(linT, uStepCurve);
                vec2 sUV = ssStart + delta * t;
                if (sUV.x < 0.0 || sUV.x > 1.0 || sUV.y < 0.0 || sUV.y > 1.0)
                    break;
                vec3 sampled = viewPosFromUV(sUV);
                vec3 rayVS = originVS + dirVS * (marchLen * t);
                float diff = sampled.z - rayVS.z;
                if (diff > minThickness && diff < thickness)
                {
                    hitT = t;
                    lightOccluded = 1.0;
                    break;
                }
            }

            float penumbra = mix(1.0, 1.0 - hitT, clamp(uPenumbraSoftness, 0.0, 4.0));
            penumbra = clamp(penumbra, 0.0, 1.0);
            occlusion += lightOccluded * penumbra * uLightStrength * weight;
        }

        return 1.0 - clamp(occlusion, 0.0, 1.0);
    }
}

render_target RT_ContactShadows {
    width_ratio = 1.0;
    height_ratio = 1.0;
    internal_format = red;
    source_type = unsigned_byte;
    source_format = red;
    mipmaps = false;
    min_filter = linear;
    mag_filter = linear;
}

render_target RT_ContactShadowsBlurred {
    width_ratio = 1.0;
    height_ratio = 1.0;
    internal_format = red;
    source_type = unsigned_byte;
    source_format = red;
    mipmaps = false;
    min_filter = linear;
    mag_filter = linear;
}

fragment cshadow_raw(target=RT_ContactShadows) {
    omw_In vec2 omw_TexCoord;

    void main()
    {
        // Skip skybox pixels: the depth there is at the far plane
        // (the sky is rendered without geometry), and tracing a
        // contact ray against an "infinite" depth fragment produces
        // a noisy ribbon across the sun / clouds. Same pattern
        // bloomlinear.omwfx uses — anything beyond 99.9% of far is
        // sky.
        if (omw_GetLinearDepth(omw_TexCoord) > omw.far * 0.999)
        {
            omw_FragColor = vec4(1.0, 0.0, 0.0, 1.0);
            return;
        }

#if OMW_NORMALS
        vec3 origin = viewPosFromUV(omw_TexCoord);
        vec3 n = omw_GetNormals(omw_TexCoord);
        if (length(n) < 0.5)
        {
            omw_FragColor = vec4(1.0, 0.0, 0.0, 1.0);
            return;
        }
        n = normalize(n);
        // Bias along the view-space normal — avoids self-shadow on
        // surfaces that face the sun at a grazing angle.
        origin += n * uBias;
#else
        omw_FragColor = vec4(1.0, 0.0, 0.0, 1.0);
        return;
#endif

        // World-space origin reused by both the sun-shadow dither
        // and the point-light helper.
        vec3 originWS = (omw.invViewMatrix * vec4(origin, 1.0)).xyz;
        float thickness = uThickness * omw.far;
        // Absolute floor (1 MW unit ≈ 1.4 cm) instead of `thickness * 0.05`.
        // The high end scales with omw.far (32k+ in exterior) so 5 % grows to
        // ~40 units, which silently rejects any mesh protruding less than
        // ~50 cm from a wall — exactly the case where contact shadows are
        // most useful. A small absolute value catches all geometric
        // occluders while still filtering pure depth-precision noise.
        float minThickness = 1.0;

        // -------- Sun shadow --------
        // Below the horizon or under heavy cloud cover, the sun pass
        // collapses to "no shadow" but the point-light pass below still
        // runs (a torch at night absolutely should cast contact shadows).
        float shadowSun = 1.0;
        vec3 sunVS = normalize((omw.viewMatrix * vec4(omw.sunPos.xyz, 0.0)).xyz);
        float sunFade = uFadeWithSun ? clamp(omw.sunVis, 0.0, 1.0) : 1.0;
        if (sunVS.z < 0.0 && sunFade >= 0.05)
        {
            float worldLength = uLength * 600.0;
            vec3 endVS = origin + sunVS * worldLength;
            vec4 clipS = omw_ProjectionMatrix() * vec4(origin, 1.0);
            vec4 clipE = omw_ProjectionMatrix() * vec4(endVS, 1.0);
            vec2 ssStart = (clipS.xy / clipS.w) * 0.5 + 0.5;
            vec2 ssEnd   = (clipE.xy / clipE.w) * 0.5 + 0.5;
            vec2 delta = ssEnd - ssStart;

            // World-anchored hash dither — pinned to the surface so
            // static geometry shows static dither even under camera
            // motion, the symptom we used to get from a per-pixel hash.
            float dither = fract(sin(dot(originWS.xyz,
                vec3(12.9898, 78.233, 37.719))) * 43758.5453);

            int steps = uSteps;
            float occluded = 0.0;
            float hitT = 1.0; // 1.0 = no hit, lower = closer to origin
            for (int i = 1; i <= steps; ++i)
            {
                // Logarithmic step distribution: samples concentrated
                // near t=0 where shadow detail is crisp.
                float linT = (float(i) + dither) / float(steps);
                float t = pow(linT, uStepCurve);
                vec2 sUV = ssStart + delta * t;
                if (sUV.x < 0.0 || sUV.x > 1.0 || sUV.y < 0.0 || sUV.y > 1.0)
                    break;
                vec3 sampled = viewPosFromUV(sUV);
                vec3 rayVS = origin + sunVS * (worldLength * t);
                float diff = sampled.z - rayVS.z;
                if (diff > minThickness && diff < thickness)
                {
                    hitT = t;
                    occluded = 1.0;
                    break;
                }
            }

            // Soft penumbra: hits near the origin = hard shadow, hits far
            // down the ray fade. Mimics the sun's angular size.
            float penumbra = mix(1.0, 1.0 - hitT, clamp(uPenumbraSoftness, 0.0, 4.0));
            penumbra = clamp(penumbra, 0.0, 1.0);
            shadowSun = 1.0 - occluded * penumbra * uStrength * sunFade;
        }

        // -------- Point-light shadows --------
        float shadowLights = pointLightShadow(origin, n, originWS,
                                              thickness, minThickness);

        // Multiply combine — same pattern as Frostbite/UE5: each shadow
        // source darkens independently, the result is the most occluded.
        float shadow = shadowSun * shadowLights;
        omw_FragColor = vec4(shadow, 0.0, 0.0, 1.0);
    }
}

fragment cshadow_blur(target=RT_ContactShadowsBlurred, rt1=RT_ContactShadows) {
    omw_In vec2 omw_TexCoord;

    void main()
    {
        if (!uBilateralBlur)
        {
            omw_FragColor = omw_Texture2D(RT_ContactShadows, omw_TexCoord);
            return;
        }

        const int kRadius = 2; // 5x5 cross
        vec2 texel = vec2(1.0) / omw.resolution;

        float refDepth = omw_GetLinearDepth(omw_TexCoord);
        float invSigma = 1.0 / max(uBlurDepthSigma, 0.001);

        float sum = 0.0;
        float weightTotal = 0.0;
        for (int dy = -kRadius; dy <= kRadius; ++dy)
        {
            for (int dx = -kRadius; dx <= kRadius; ++dx)
            {
                vec2 sUV = omw_TexCoord + vec2(float(dx), float(dy)) * texel;
                float sDepth = omw_GetLinearDepth(sUV);
                float depthDiff = abs(sDepth - refDepth) * invSigma;
                float spatialW = exp(-0.5 * float(dx*dx + dy*dy) * 0.25);
                float depthW = exp(-0.5 * depthDiff * depthDiff);
                float w = spatialW * depthW;
                sum += omw_Texture2D(RT_ContactShadows, sUV).r * w;
                weightTotal += w;
            }
        }
        omw_FragColor = vec4(weightTotal > 0.0 ? sum / weightTotal : 1.0, 0.0, 0.0, 1.0);
    }
}

fragment main(rt1=RT_ContactShadowsBlurred) {
    omw_In vec2 omw_TexCoord;

    void main()
    {
        vec4 col = omw_GetLastShader(omw_TexCoord);
        float shadow = omw_Texture2D(RT_ContactShadowsBlurred, omw_TexCoord).r;
        if (uDebugView)
        {
            omw_FragColor = vec4(shadow, shadow, shadow, 1.0);
            return;
        }
        omw_FragColor = vec4(col.rgb * shadow, col.a);
    }
}

technique {
    description = "Standalone screen-space contact shadows. AAA-style: bilateral blur, soft penumbra by occluder distance, logarithmic step distribution, plus per-pixel raymarche from up to N closest dynamic point lights (torches, spells). Driven by omw.sunPos + omw.sunVis + omw_PointLights[], decoupled from internal_raycast so the user can A/B and tune in isolation.";
    author = "OpenMW Boost";
    version = "1.2";
    passes = cshadow_raw, cshadow_blur, main;
    pass_normals = true;
    pass_lights = true;
}
