uniform_int uSteps {
    default = 38;
    min = 8;
    max = 128;
    step = 1;
    display_name = "Contact Shadow Steps";
    description = "Per-pixel raymarch steps. Higher = smoother / longer shadows, slower.";
}

uniform_float uLength {
    default = 0.05;
    min = 0.01;
    max = 0.5;
    step = 0.005;
    display_name = "Length";
    description = "World-space ray length toward the sun (×600 MW units). Longer rays = bigger shadow footprint, more banding at the same step count.";
}

uniform_float uThickness {
    default = 0.025;
    min = 0.005;
    max = 0.1;
    step = 0.001;
    display_name = "Thickness";
    description = "Depth-difference window that counts as an occluder. Lower = thinner / less false-positives at silhouettes; higher = catches finer features at the cost of edge artefacts.";
}

uniform_float uStrength {
    default = 0.7;
    min = 0.0;
    max = 1.0;
    step = 0.05;
    display_name = "Strength";
    description = "Final darkening on occluded pixels. 1.0 = pure black on hit, 0.0 = effect off.";
}

uniform_float uBias {
    default = 4.0;
    min = 0.0;
    max = 20.0;
    step = 0.5;
    display_name = "Surface Bias";
    description = "Distance (in MW units) the ray origin is pushed along the surface normal before marching. Prevents self-shadow at glancing angles.";
}

uniform_float uPenumbraSoftness {
    default = 1.0;
    min = 0.0;
    max = 4.0;
    step = 0.1;
    display_name = "Penumbra Softness";
    description = "Distance-based soft-shadow ramp. 0 = hard binary shadow (occluded or not). Higher = occluders far down the ray cast progressively softer shadows, mimicking the sun's angular size.";
}

uniform_float uStepCurve {
    default = 1.5;
    min = 1.0;
    max = 3.0;
    step = 0.1;
    display_name = "Step Curve";
    description = "Logarithmic step distribution along the ray. 1 = uniform (every sample equally spaced), >1 concentrates samples close to the surface where the shadow detail is, leaving fewer samples for the far end where banding is invisible anyway.";
}

uniform_bool uBilateralBlur {
    default = true;
    display_name = "Bilateral Blur";
    description = "Apply a depth-aware 5x5 cross blur to the raw shadow buffer to smooth out raymarche noise without bleeding across silhouettes.";
}

uniform_float uBlurDepthSigma {
    default = 30.0;
    min = 1.0;
    max = 200.0;
    step = 1.0;
    display_name = "Blur Depth Threshold";
    description = "View-space depth (units) over which the blur weight falls off — keeps shadows from leaking across geometric edges.";
}

uniform_bool uFadeWithSun {
    default = true;
    display_name = "Fade With Sun Visibility";
    description = "Multiply the effect by omw.sunVis so the shadow softens when clouds occlude the sun and disappears at night.";
}

shared {
    vec3 viewPosFromUV(vec2 uv)
    {
        float d = omw_GetDepth(uv);
#if (OMW_REVERSE_Z == 1)
        float ndcZ = 1.0 - d;
#else
        float ndcZ = d * 2.0 - 1.0;
#endif
        vec4 ndc = vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
        vec4 view = omw_InvProjectionMatrix() * ndc;
        return view.xyz / view.w;
    }
}

render_target RT_ContactShadows {
    width_ratio = 1.0;
    height_ratio = 1.0;
    internal_format = red;
    source_type = unsigned_byte;
    source_format = red;
    mipmaps = false;
    min_filter = linear;
    mag_filter = linear;
}

render_target RT_ContactShadowsBlurred {
    width_ratio = 1.0;
    height_ratio = 1.0;
    internal_format = red;
    source_type = unsigned_byte;
    source_format = red;
    mipmaps = false;
    min_filter = linear;
    mag_filter = linear;
}

fragment cshadow_raw(target=RT_ContactShadows) {
    omw_In vec2 omw_TexCoord;

    void main()
    {
        // Sun direction in view space. omw.sunPos is a directional
        // light expressed as a position; normalising gives the
        // inverse light dir. Below the horizon → no shadow to draw.
        vec3 sunVS = normalize((omw.viewMatrix * vec4(omw.sunPos.xyz, 0.0)).xyz);
        if (sunVS.z >= 0.0)
        {
            omw_FragColor = vec4(1.0, 0.0, 0.0, 1.0);
            return;
        }

        // Sun-visibility fade — at night / under heavy cloud cover
        // omw.sunVis approaches 0, so the contact shadow softens to
        // nothing instead of staying full strength against the sun
        // direction the engine computed earlier in the day.
        float sunFade = uFadeWithSun ? clamp(omw.sunVis, 0.0, 1.0) : 1.0;
        if (sunFade < 0.05)
        {
            omw_FragColor = vec4(1.0, 0.0, 0.0, 1.0);
            return;
        }

        // Skip skybox pixels: the depth there is at the far plane
        // (the sky is rendered without geometry), and tracing a
        // contact ray against an "infinite" depth fragment produces
        // a noisy ribbon across the sun / clouds. Same pattern
        // bloomlinear.omwfx uses — anything beyond 99.9% of far is
        // sky.
        if (omw_GetLinearDepth(omw_TexCoord) > omw.far * 0.999)
        {
            omw_FragColor = vec4(1.0, 0.0, 0.0, 1.0);
            return;
        }

#if OMW_NORMALS
        vec3 origin = viewPosFromUV(omw_TexCoord);
        vec3 n = omw_GetNormals(omw_TexCoord);
        if (length(n) < 0.5)
        {
            omw_FragColor = vec4(1.0, 0.0, 0.0, 1.0);
            return;
        }
        n = normalize(n);
        // Bias along the view-space normal — avoids self-shadow on
        // surfaces that face the sun at a grazing angle.
        origin += n * uBias;
#else
        omw_FragColor = vec4(1.0, 0.0, 0.0, 1.0);
        return;
#endif

        // Project the start + end into screen space so we can step
        // along the depth buffer.
        float worldLength = uLength * 600.0;
        vec3 endVS = origin + sunVS * worldLength;
        vec4 clipS = omw_ProjectionMatrix() * vec4(origin, 1.0);
        vec4 clipE = omw_ProjectionMatrix() * vec4(endVS, 1.0);
        vec2 ssStart = (clipS.xy / clipS.w) * 0.5 + 0.5;
        vec2 ssEnd   = (clipE.xy / clipE.w) * 0.5 + 0.5;
        vec2 delta = ssEnd - ssStart;

        // World-anchored hash dither — pinned to the surface so
        // static geometry shows static dither even under camera
        // motion, the symptom we used to get from a per-pixel hash.
        vec3 originWS = (omw.invViewMatrix * vec4(origin, 1.0)).xyz;
        float dither = fract(sin(dot(originWS.xyz,
            vec3(12.9898, 78.233, 37.719))) * 43758.5453);

        int steps = uSteps;
        float thickness = uThickness * omw.far;
        float minThickness = thickness * 0.05;
        float invStepCurve = 1.0 / max(uStepCurve, 1.0);

        float occluded = 0.0;
        float hitT = 1.0; // 1.0 = no hit, lower = closer to origin
        for (int i = 1; i <= steps; ++i)
        {
            // Logarithmic step distribution: pow((i + dither)/steps,
            // uStepCurve) > linear means samples are concentrated
            // near t=0 (close to the origin where shadow detail is
            // crisp) and stretched toward t=1 (far end where the
            // contact shadow is fading anyway). uStepCurve=1 falls
            // back to uniform sampling.
            float linT = (float(i) + dither) / float(steps);
            float t = pow(linT, uStepCurve);
            vec2 sUV = ssStart + delta * t;
            if (sUV.x < 0.0 || sUV.x > 1.0 || sUV.y < 0.0 || sUV.y > 1.0)
                break;
            vec3 sampled = viewPosFromUV(sUV);
            vec3 rayVS = origin + sunVS * (worldLength * t);
            float diff = sampled.z - rayVS.z;
            if (diff > minThickness && diff < thickness)
            {
                hitT = t;
                occluded = 1.0;
                break;
            }
        }

        // Soft penumbra: a hit close to the origin (small hitT) gives
        // a hard / dark shadow; a hit far down the ray fades. Mimics
        // the angular size of the sun — far-away occluders cast
        // soft penumbral edges. uPenumbraSoftness=0 falls back to
        // a hard binary shadow.
        float penumbra = mix(1.0, 1.0 - hitT, clamp(uPenumbraSoftness, 0.0, 4.0));
        // Clamp penumbra below 1.0 so an early-out hit still gets
        // some occlusion budget (1.0 is reserved for "no hit").
        penumbra = clamp(penumbra, 0.0, 1.0);
        float shadow = 1.0 - occluded * penumbra * uStrength * sunFade;
        omw_FragColor = vec4(shadow, 0.0, 0.0, 1.0);
    }
}

fragment cshadow_blur(target=RT_ContactShadowsBlurred, rt1=RT_ContactShadows) {
    omw_In vec2 omw_TexCoord;

    void main()
    {
        if (!uBilateralBlur)
        {
            omw_FragColor = omw_Texture2D(RT_ContactShadows, omw_TexCoord);
            return;
        }

        const int kRadius = 2; // 5x5 cross
        vec2 texel = vec2(1.0) / omw.resolution;

        float refDepth = omw_GetLinearDepth(omw_TexCoord);
        float invSigma = 1.0 / max(uBlurDepthSigma, 0.001);

        float sum = 0.0;
        float weightTotal = 0.0;
        for (int dy = -kRadius; dy <= kRadius; ++dy)
        {
            for (int dx = -kRadius; dx <= kRadius; ++dx)
            {
                vec2 sUV = omw_TexCoord + vec2(float(dx), float(dy)) * texel;
                float sDepth = omw_GetLinearDepth(sUV);
                float depthDiff = abs(sDepth - refDepth) * invSigma;
                float spatialW = exp(-0.5 * float(dx*dx + dy*dy) * 0.25);
                float depthW = exp(-0.5 * depthDiff * depthDiff);
                float w = spatialW * depthW;
                sum += omw_Texture2D(RT_ContactShadows, sUV).r * w;
                weightTotal += w;
            }
        }
        omw_FragColor = vec4(weightTotal > 0.0 ? sum / weightTotal : 1.0, 0.0, 0.0, 1.0);
    }
}

fragment main(rt1=RT_ContactShadowsBlurred) {
    omw_In vec2 omw_TexCoord;

    void main()
    {
        vec4 col = omw_GetLastShader(omw_TexCoord);
        float shadow = omw_Texture2D(RT_ContactShadowsBlurred, omw_TexCoord).r;
        omw_FragColor = vec4(col.rgb * shadow, col.a);
    }
}

technique {
    description = "Standalone screen-space contact shadows toward the sun. AAA-style: bilateral blur, soft penumbra by occluder distance, logarithmic step distribution. Driven by omw.sunPos + omw.sunVis, decoupled from internal_raycast so the user can A/B and tune in isolation.";
    author = "OpenMW Boost";
    version = "1.1";
    passes = cshadow_raw, cshadow_blur, main;
    pass_normals = true;
}
