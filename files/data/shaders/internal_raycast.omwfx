uniform_bool uContactShadows {
    default = false;
}
uniform_int uContactShadowsSteps {
    default = 12;
    min = 4;
    max = 64;
    step = 1;
}
uniform_float uContactShadowsLength {
    default = 0.05;
    min = 0.0;
    max = 1.0;
    step = 0.02;
}
// Parallax mapping depth — mirrored each frame to the scene-root
// 'parallaxScale' / 'parallaxBias' uniforms by RenderingManager so
// objects.frag's POM step picks them up live. The technique itself
// doesn't sample these.
uniform_float uParallaxScale {
    default = 0.04;
    min = 0.0;
    max = 0.5;
    step = 0.01;
}
uniform_float uParallaxBias {
    default = -0.02;
    min = -0.25;
    max = 0.25;
    step = 0.01;
}
uniform_float uContactShadowsThickness {
    default = 0.005;
    min = 0.0;
    max = 1.0;
    step = 0.02;
}
uniform_bool uSsao {
    default = false;
}
uniform_float uSsaoRadius {
    default = 80.0;
    min = 0.05;
    max = 1024.0;
    step = 30;
}
uniform_float uSsaoStrength {
    default = 1.0;
    min = 0.0;
    max = 4.0;
    step = 0.1;
}
uniform_int uSsaoSamples {
    default = 8;
    min = 2;
    max = 32;
    step = 1;
}
uniform_bool uSunHalo {
    default = true;
}
uniform_bool uWorldSSR {
    default = false;
}
uniform_int uWorldSSRSteps {
    default = 16;
    min = 4;
    max = 64;
    step = 1;
}
uniform_float uWorldSSRStrength {
    default = 0.6;
    min = 0.0;
    max = 2.0;
    step = 0.05;
}
uniform_float uWorldSSRSmoothness {
    default = 0.7;
    min = 0.0;
    max = 1.0;
    step = 0.02;
}
uniform_float uWetness {
    default = 0.4;
    min = 0.0;
    max = 1.0;
    step = 0.02;
}
uniform_bool uGodRays {
    default = true;
}
uniform_int uGodRaysSteps {
    default = 32;
    min = 8;
    max = 96;
    step = 1;
}
uniform_float uGodRaysDecay {
    default = 0.96;
    min = 0.5;
    max = 1.0;
    step = 0.01;
}
uniform_float uGodRaysIntensity {
    default = 0.6;
    min = 0.0;
    max = 4.0;
    step = 0.1;
}
uniform_bool uUnderwaterEffects {
    default = true;
}
uniform_float uCausticsStrength {
    default = 0.45;
    min = 0.0;
    max = 2.0;
    step = 0.05;
}
uniform_float uCausticsScale {
    default = 0.06;
    min = 0.005;
    max = 0.5;
    step = 0.01;
}
uniform_float uUnderwaterTint {
    default = 0.6;
    min = 0.0;
    max = 1.0;
    step = 0.02;
}
uniform_float uUnderwaterFogDistance {
    default = 2400.0;
    min = 100.0;
    max = 16000.0;
    step = 400;
}
uniform_bool uAtmoScatter {
    default = true;
}
uniform_float uAtmoIntensity {
    default = 0.8;
    min = 0.0;
    max = 3.0;
    step = 0.08;
}
uniform_float uAtmoSunSize {
    default = 350.0;
    min = 50.0;
    max = 2000.0;
    step = 50;
}
uniform_bool uVolumetricClouds {
    default = false;
}
uniform_float uCloudCoverage {
    default = 0.45;
    min = 0.0;
    max = 1.0;
    step = 0.02;
}
uniform_float uCloudDensity {
    default = 0.6;
    min = 0.0;
    max = 2.0;
    step = 0.05;
}
uniform_int uCloudMarchSteps {
    default = 24;
    min = 8;
    max = 64;
    step = 1;
}
uniform_int uCloudLightSteps {
    default = 4;
    min = 1;
    max = 16;
    step = 1;
}
uniform_float uCloudHeight {
    default = 4500.0;
    min = 500.0;
    max = 20000.0;
    step = 500;
}
uniform_float uCloudThickness {
    default = 1800.0;
    min = 200.0;
    max = 8000.0;
    step = 200;
}
uniform_float uCloudScale {
    default = 0.00012;
    min = 0.00001;
    max = 0.001;
    step = 2e-05;
}
uniform_float uCloudSpeed {
    default = 12.0;
    min = 0.0;
    max = 200.0;
    step = 5;
}
uniform_bool uVolumetricFog {
    default = true;
}
uniform_int uVolumetricFogSteps {
    default = 24;
    min = 4;
    max = 96;
    step = 1;
}
uniform_float uVolumetricFogDensity {
    default = 0.00018;
    min = 0.0;
    max = 0.005;
    step = 0.0001;
}
uniform_float uVolumetricFogHeightFalloff {
    default = 0.0009;
    min = 0.0;
    max = 0.01;
    step = 0.0002;
}
uniform_float uVolumetricFogScattering {
    default = 0.5;
    min = 0.0;
    max = 1.0;
    step = 0.02;
}
uniform_bool uEyeAdaptation {
    default = false;
}
uniform_float uEyeAdaptationTarget {
    default = 0.45;
    min = 0.05;
    max = 1.0;
    step = 0.02;
}
uniform_float uEyeAdaptationMin {
    default = 0.85;
    min = 0.1;
    max = 1.0;
    step = 0.02;
}
uniform_float uEyeAdaptationMax {
    default = 1.4;
    min = 1.0;
    max = 4.0;
    step = 0.08;
}
uniform_float uEyeAdaptationStrength {
    default = 0.25;
    min = 0.0;
    max = 1.0;
    step = 0.02;
}
uniform_float uSunHaloRadius {
    default = 0.18;
    min = 0.01;
    max = 0.5;
    step = 0.01;
}
uniform_float uSunHaloIntensity {
    default = 1.2;
    min = 0.0;
    max = 6.0;
    step = 0.1;
}

fragment main {

    omw_In vec2 omw_TexCoord;

    // Reconstruct view-space position from depth using the inverse projection.
    vec3 viewPosFromUV(vec2 uv)
    {
        float d = omw_GetDepth(uv);
#if (OMW_REVERSE_Z == 1)
        float ndcZ = 1.0 - d;
#else
        float ndcZ = d * 2.0 - 1.0;
#endif
        vec4 ndc = vec4(uv * 2.0 - 1.0, ndcZ, 1.0);
        vec4 view = omw_InvProjectionMatrix() * ndc;
        return view.xyz / view.w;
    }

    // Forward-declared noise helpers (used by clouds / caustics / fbm).
    vec2 hash22(vec2 p)
    {
        p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
        return -1.0 + 2.0 * fract(sin(p) * 43758.5453);
    }

    float gradNoise(vec2 p)
    {
        vec2 i = floor(p);
        vec2 f = fract(p);
        vec2 u = f * f * (3.0 - 2.0 * f);
        return mix(mix(dot(hash22(i + vec2(0, 0)), f - vec2(0, 0)),
                       dot(hash22(i + vec2(1, 0)), f - vec2(1, 0)), u.x),
                   mix(dot(hash22(i + vec2(0, 1)), f - vec2(0, 1)),
                       dot(hash22(i + vec2(1, 1)), f - vec2(1, 1)), u.x), u.y);
    }

    // Bayer 4x4 dither matrix to break up banding in the raymarch.
    float bayer4x4(vec2 p)
    {
        int x = int(mod(p.x, 4.0));
        int y = int(mod(p.y, 4.0));
        int idx = y * 4 + x;
        // Standard 4x4 Bayer table normalised to [0..1).
        const float tab[16] = float[16](
             0.0/16.0,  8.0/16.0,  2.0/16.0, 10.0/16.0,
            12.0/16.0,  4.0/16.0, 14.0/16.0,  6.0/16.0,
             3.0/16.0, 11.0/16.0,  1.0/16.0,  9.0/16.0,
            15.0/16.0,  7.0/16.0, 13.0/16.0,  5.0/16.0
        );
        return tab[idx];
    }

    // -------------------------------------------------------------------
    // Contact shadows
    // -------------------------------------------------------------------
    // Marches a short ray from the surface toward the sun, in screen space.
    // Returns 1.0 if unoccluded, 0.0 if a depth occluder was hit.
    float contactShadow(vec2 uv)
    {
        if (!uContactShadows) return 1.0;

        // Sun direction in view space. omw.sunPos is a directional light
        // expressed as a position; normalising gives the inverse light dir.
        vec3 sunVS = normalize((omw.viewMatrix * vec4(omw.sunPos.xyz, 0.0)).xyz);
        if (sunVS.z >= 0.0) return 1.0; // sun behind / below — skip

        vec3 origin = viewPosFromUV(uv);
        // Bias along view-space normal to avoid self-shadowing.
        // Larger bias kills the "shadow per edge" artefact that arises when
        // depth discontinuities are misread as occluders by the raymarche.
        vec3 n = omw_GetNormals(uv);
        origin += n * 4.0;

        // Project a step into clip space to convert into screen-space delta.
        // Fixed world-space length (cm Morrowind units) so shadows have a
        // consistent footprint regardless of distance — previous formula
        // scaled by length(origin), creating runaway shadows that filled
        // half the screen when the player rotated the camera.
        float worldLength = uContactShadowsLength * 600.0;
        vec3 endVS = origin + sunVS * worldLength;
        vec4 clipS = omw_ProjectionMatrix() * vec4(origin, 1.0);
        vec4 clipE = omw_ProjectionMatrix() * vec4(endVS, 1.0);
        vec2 ssStart = (clipS.xy / clipS.w) * 0.5 + 0.5;
        vec2 ssEnd   = (clipE.xy / clipE.w) * 0.5 + 0.5;

        vec2 delta = ssEnd - ssStart;
        int steps = uContactShadowsSteps;
        // World-space dither: the previous bayer4x4(gl_FragCoord.xy)
        // re-rolled per pixel as the camera moved, which made the
        // contact-shadow noise crawl across geometry and read as a
        // shadow that "followed" the camera. Hashing the reconstructed
        // world position pins the pattern to the surface, so static
        // geometry shows static dither even under camera motion.
        vec3 originWS = (omw.invViewMatrix * vec4(origin, 1.0)).xyz;
        float dither = fract(sin(dot(originWS.xyz,
            vec3(12.9898, 78.233, 37.719))) * 43758.5453);
        float occluded = 0.0;

        for (int i = 1; i <= steps; ++i)
        {
            float t = (float(i) + dither) / float(steps);
            vec2 sUV = ssStart + delta * t;
            if (sUV.x < 0.0 || sUV.x > 1.0 || sUV.y < 0.0 || sUV.y > 1.0)
                break;
            // Reconstruct sampled position and compare with our ray's z.
            vec3 sampled = viewPosFromUV(sUV);
            vec3 rayVS = origin + sunVS * (worldLength * t);
            float diff = sampled.z - rayVS.z;
            // Tighter thickness window: depth discontinuities at silhouette
            // edges otherwise read as occluders. Lower bound rejects almost-
            // matched depths (the surface itself, slightly biased).
            float thickness = uContactShadowsThickness * omw.far;
            float minThickness = thickness * 0.05;
            if (diff > minThickness && diff < thickness)
            {
                occluded = 1.0;
                break;
            }
        }
        // Soft mix: full occlusion would crush all detail; let the base
        // shadowing breathe through at 30% even on a hit.
        return 1.0 - occluded * 0.7;
    }

    // -------------------------------------------------------------------
    // GTAO-style horizon-based ambient occlusion
    // -------------------------------------------------------------------
    float ambientOcclusion(vec2 uv)
    {
        if (!uSsao) return 1.0;

        vec3 origin = viewPosFromUV(uv);
        vec3 n = omw_GetNormals(uv);
        if (length(n) < 0.5) return 1.0;
        n = normalize(n);

        // Screen-space radius proportional to world radius / depth.
        vec2 res = omw.resolution;
        float pxRadius = uSsaoRadius * res.y / max(0.001, -origin.z) * 0.5;
        pxRadius = clamp(pxRadius, 4.0, 0.25 * res.y);
        vec2 uvRadius = vec2(pxRadius) / res;

        int samples = uSsaoSamples;
        // World-anchored dither — same reasoning as contactShadow: a
        // gl_FragCoord-based pattern crawls with the camera and looks
        // like a moving shadow on static geometry.
        vec3 originWS = (omw.invViewMatrix * vec4(origin, 1.0)).xyz;
        float dither = fract(sin(dot(originWS.xyz,
            vec3(12.9898, 78.233, 37.719))) * 43758.5453);
        float ao = 0.0;
        const float TWO_PI = 6.2831853;

        for (int i = 0; i < samples; ++i)
        {
            float angle = (float(i) + dither) / float(samples) * TWO_PI;
            vec2 dir = vec2(cos(angle), sin(angle));
            vec2 sUV = uv + dir * uvRadius;
            if (sUV.x < 0.0 || sUV.x > 1.0 || sUV.y < 0.0 || sUV.y > 1.0)
                continue;
            vec3 sampled = viewPosFromUV(sUV);
            vec3 toSample = sampled - origin;
            float d2 = dot(toSample, toSample);
            // Falloff with distance so distant points don't dominate.
            float falloff = clamp(1.0 - d2 / (uSsaoRadius * uSsaoRadius), 0.0, 1.0);
            float horizon = max(0.0, dot(n, normalize(toSample))) * falloff;
            ao += horizon;
        }
        ao = clamp(1.0 - ao * uSsaoStrength / float(samples), 0.0, 1.0);
        return ao;
    }

    // -------------------------------------------------------------------
    // Sun halo / glare
    // -------------------------------------------------------------------
    // Project the sun's world-space direction into screen space and add a
    // soft additive disc + Gaussian falloff. The halo is *not* gated by
    // depth so it bleeds through thin/transparent geometry, but it is
    // gated by occlusion of the sun's own pixel (if the sun is behind a
    // mountain, no halo).
    vec3 sunHalo(vec2 uv)
    {
        if (!uSunHalo) return vec3(0.0);

        // Sun direction in clip space.
        vec3 sunVS = (omw.viewMatrix * vec4(omw.sunPos.xyz, 0.0)).xyz;
        if (sunVS.z >= 0.0) return vec3(0.0); // sun behind camera
        vec4 sunClip = omw_ProjectionMatrix() * vec4(sunVS, 1.0);
        if (sunClip.w <= 0.0) return vec3(0.0);
        vec2 sunUV = sunClip.xy / sunClip.w * 0.5 + 0.5;

        // Distance from the fragment to the projected sun (aspect-corrected).
        vec2 res = omw.resolution;
        float aspect = res.x / max(1.0, res.y);
        vec2 d = (uv - sunUV) * vec2(aspect, 1.0);
        float dist = length(d);

        if (dist > uSunHaloRadius * 2.0) return vec3(0.0);

        // Two-lobe falloff: a hot inner disc + a soft Gaussian outer halo.
        float inner = smoothstep(uSunHaloRadius * 0.4, 0.0, dist);
        float outer = exp(-pow(dist / uSunHaloRadius, 2.0) * 6.0);
        float intensity = (inner * 1.5 + outer) * uSunHaloIntensity;

        // Occlude the halo when the sun's own pixel is behind geometry.
        // Sample the depth at sunUV; if it's not at the far plane the sun
        // is hidden by an occluder, so kill the halo.
        if (sunUV.x >= 0.0 && sunUV.x <= 1.0 && sunUV.y >= 0.0 && sunUV.y <= 1.0)
        {
            float sunPixelDepth = omw_GetDepth(sunUV);
#if (OMW_REVERSE_Z == 1)
            bool occluded = sunPixelDepth > 0.001;
#else
            bool occluded = sunPixelDepth < 0.99999;
#endif
            if (occluded) intensity *= 0.15; // bleed-through, not full kill
        }

        return omw.sunColor.rgb * intensity;
    }

    // -------------------------------------------------------------------
    // Volumetric clouds with self-shadowing
    // -------------------------------------------------------------------
    // Raymarches the view ray through a thin slab between altitude
    // [uCloudHeight, uCloudHeight + uCloudThickness]. Density at each
    // sample is derived from a 3D-ish FBM (we layer four 2D noise
    // octaves slid by simulationTime to fake 3D motion). For each dense
    // step a *secondary* raymarche toward the sun computes how much
    // light made it through the cloud above the sample point, giving
    // self-shadowing without storing a 3D volume.
    float cloudDensity(vec3 p)
    {
        // Slab-aligned coordinates in the [0..1] vertical band.
        float t = clamp((p.z - uCloudHeight) / uCloudThickness, 0.0, 1.0);
        // Vertical density envelope: low at edges, peak around 60% up.
        float vEnv = smoothstep(0.0, 0.25, t) * smoothstep(1.0, 0.75, t);

        vec2 wind = vec2(omw.simulationTime * uCloudSpeed,
                         omw.simulationTime * uCloudSpeed * 0.6);
        vec2 uv = p.xy * uCloudScale + wind * uCloudScale;

        // Layered FBM with vertical-shifted octaves (cheap 3D feel).
        float n = 0.0;
        float amp = 0.5;
        float freq = 1.0;
        for (int i = 0; i < 4; ++i)
        {
            n += amp * gradNoise(uv * freq + vec2(t * 4.0 * float(i), 0.0));
            freq *= 2.13;
            amp *= 0.5;
        }
        n = n * 0.5 + 0.5;

        // Coverage threshold turns the noise into puffy cloud bodies.
        float cov = clamp(n - (1.0 - uCloudCoverage), 0.0, 1.0);
        return cov * vEnv * uCloudDensity;
    }

    float cloudLightTransmittance(vec3 p, vec3 sunDir)
    {
        int steps = uCloudLightSteps;
        float stepLen = uCloudThickness * 0.4 / float(steps);
        float opticalDepth = 0.0;
        for (int i = 1; i <= steps; ++i)
        {
            vec3 sp = p + sunDir * (float(i) * stepLen);
            opticalDepth += cloudDensity(sp) * stepLen;
        }
        return exp(-opticalDepth * 1.2);
    }

    vec3 volumetricClouds(vec2 uv, vec3 viewDirWS, vec3 sunDirWS, vec3 skyBackground)
    {
        if (!uVolumetricClouds) return skyBackground;
        if (viewDirWS.z <= 0.02) return skyBackground; // looking down: no clouds

        vec3 origin = omw.eyePos.xyz;
        // Intersect view ray with the cloud slab vertically.
        float t0 = (uCloudHeight - origin.z) / max(viewDirWS.z, 0.001);
        float t1 = (uCloudHeight + uCloudThickness - origin.z) / max(viewDirWS.z, 0.001);
        float tEnter = max(0.0, min(t0, t1));
        float tExit  = max(t0, t1);
        if (tExit <= tEnter) return skyBackground;
        // Cap distance: don't march past 80km (~horizon).
        tExit = min(tExit, tEnter + 80000.0);

        int steps = uCloudMarchSteps;
        float stepLen = (tExit - tEnter) / float(steps);
        float dither = bayer4x4(gl_FragCoord.xy);

        vec3 sunCol = omw.sunColor.rgb;
        vec3 ambient = mix(vec3(0.55, 0.65, 0.78), vec3(0.18, 0.22, 0.30),
                           smoothstep(0.0, -0.2, sunDirWS.z));

        // Henyey-Greenstein with anisotropy biased forward (clouds glow
        // around the sun direction).
        float g = 0.4;
        float cosA = dot(viewDirWS, sunDirWS);
        float hg = (1.0 - g * g) /
                   (4.0 * 3.14159 * pow(1.0 + g * g - 2.0 * g * cosA, 1.5));

        float transmittance = 1.0;
        vec3 scattered = vec3(0.0);

        for (int i = 0; i < steps; ++i)
        {
            float t = tEnter + (float(i) + dither) * stepLen;
            vec3 p = origin + viewDirWS * t;
            float density = cloudDensity(p);
            if (density > 0.001)
            {
                float lightT = cloudLightTransmittance(p, sunDirWS);
                vec3 inscatter = (sunCol * hg * lightT + ambient * 0.4) * density * stepLen;
                scattered += inscatter * transmittance;
                transmittance *= exp(-density * stepLen * 1.5);
                if (transmittance < 0.01) break;
            }
        }

        return skyBackground * transmittance + scattered;
    }

    // -------------------------------------------------------------------
    // Atmospheric Rayleigh+Mie scattering (sky tint)
    // -------------------------------------------------------------------
    // Replaces the flat OpenMW sky color on sky pixels with a procedural
    // Rayleigh+Mie scattered sky. Cheap analytic approximation:
    //   - Zenith colour interpolates between deep blue (high sun) and
    //     warm purple (sun near horizon).
    //   - Horizon colour blends to orange/red as the sun lowers.
    //   - Mie phase function adds the bright sun-disc glow + halo around
    //     the sun direction.
    // Mixed with the existing sky colour so weather effects remain visible.
    vec3 atmoSky(vec3 viewDirWS, vec3 sunDirWS, float intensity)
    {
        // Sun height controls overall colour shift.
        float sunY = clamp(sunDirWS.z, -0.2, 1.0);
        float sunset = 1.0 - smoothstep(0.0, 0.35, sunY);

        // Zenith blue → twilight purple.
        vec3 zenithDay   = vec3(0.18, 0.42, 0.85);
        vec3 zenithNight = vec3(0.05, 0.06, 0.18);
        vec3 zenith = mix(zenithDay, zenithNight, smoothstep(0.0, -0.2, sunY));

        // Horizon orange → cyan.
        vec3 horizonDay    = vec3(0.78, 0.85, 0.92);
        vec3 horizonSunset = vec3(1.05, 0.55, 0.30);
        vec3 horizonNight  = vec3(0.12, 0.10, 0.18);
        vec3 horizon = mix(horizonDay, horizonSunset, sunset);
        horizon = mix(horizon, horizonNight, smoothstep(0.0, -0.2, sunY));

        // Vertical gradient.
        float h = clamp(viewDirWS.z, 0.0, 1.0);
        float vGrad = pow(1.0 - h, 3.0);
        vec3 sky = mix(zenith, horizon, vGrad);

        // Rayleigh tint: low-altitude rays go through more atmosphere when
        // looking toward the sun — boost warm tones in that direction.
        float towardSun = clamp(dot(viewDirWS, sunDirWS), 0.0, 1.0);
        sky += vec3(0.30, 0.10, 0.0) * pow(towardSun, 4.0) * sunset;

        // Mie phase: bright forward scattering peak (the sun's glow halo).
        float miePhase = pow(towardSun, 8.0) * 0.6
                       + pow(towardSun, 32.0) * 1.4;
        sky += omw.sunColor.rgb * miePhase * smoothstep(-0.1, 0.1, sunY);

        // Sun disc itself.
        float sunDot = dot(viewDirWS, sunDirWS);
        float disc = smoothstep(0.9985, 1.0, sunDot);
        sky += omw.sunColor.rgb * disc * 5.0;

        return sky * intensity;
    }

    // -------------------------------------------------------------------
    // Underwater caustics + light scattering
    // -------------------------------------------------------------------
    // When the camera is below the water surface, overlay an animated
    // caustic pattern (procedural sum of two rotating cosine fields) and
    // tint+fog the scene as the depth increases. Caustics modulate by sky
    // luminance so they vanish in covered areas (no sun ray reaches the
    // bottom). Animated by omw.simulationTime via the "omw" UBO.
    float caustics(vec2 p, float t)
    {
        // Two rotated noise layers add a "rippling cell" pattern that mimics
        // refraction through wave fronts.
        float a = gradNoise(p * 1.0 + vec2( cos(t * 0.4),  sin(t * 0.4)) * 1.3);
        float b = gradNoise(p * 1.7 + vec2(-sin(t * 0.7),  cos(t * 0.7)) * 1.6);
        float n = (a + b) * 0.5;
        // Sharpen into bright "veins": pow on absolute value.
        float caust = 1.0 - abs(n);
        return pow(clamp(caust, 0.0, 1.0), 6.0);
    }

    vec3 applyUnderwater(vec3 col, vec2 uv)
    {
        if (!uUnderwaterEffects) return col;
        if (!bool(omw.isUnderwater)) return col;

        // World-space position of the fragment for caustic UV.
        vec3 worldPos = omw_GetWorldPosFromUV(uv);
        float t = omw.simulationTime;
        float caust = caustics(worldPos.xy * uCausticsScale, t) * uCausticsStrength;

        // Sky-vis modulation: caustics need the sun reaching the bottom.
        // Cheap proxy: are we looking at a pixel whose normal points up?
        vec3 n = omw_GetNormals(uv);
        float upMask = clamp(n.z * 0.5 + 0.5, 0.0, 1.0);
        upMask = pow(upMask, 1.5);
        caust *= upMask;

        // Tinted caustics: cool turquoise with a hint of sun warmth.
        vec3 caustColor = mix(vec3(0.6, 0.95, 0.95), omw.sunColor.rgb, 0.5);
        col += caustColor * caust;

        // Underwater volumetric fog: fade everything to a deep blue/green
        // exponentially with view distance. Stronger as the player descends
        // (we don't know exact submersion depth — proxy: linear depth).
        float linearD = omw_GetLinearDepth(uv);
        float fogAmount = 1.0 - exp(-linearD / max(1.0, uUnderwaterFogDistance));
        vec3 deep = mix(vec3(0.05, 0.18, 0.22), vec3(0.02, 0.08, 0.12), fogAmount);
        col = mix(col, deep, fogAmount * uUnderwaterTint);

        return col;
    }

    // -------------------------------------------------------------------
    // Eye adaptation (auto-exposure)
    // -------------------------------------------------------------------
    // Estimates the average luminance of the visible scene by sampling
    // omw_GetLastShader at a 4x4 grid, then derives an exposure multiplier
    // that pushes the mean luminance toward uEyeAdaptationTarget. Clamped
    // to [min, max] and mixed with 1.0 by uEyeAdaptationStrength so the
    // user can dial in how aggressive the adaptation is.
    // No temporal smoothing here — the natural smoothness of luminance
    // sampling at large radii prevents most flicker; for frame-by-frame
    // smoothing we would need a persistent UBO field which omwfx doesn't
    // expose to user techniques.
    vec3 applyEyeAdaptation(vec3 col)
    {
        if (!uEyeAdaptation) return col;

        float lum = 0.0;
        // 4x4 grid centred over the screen, weighted by gaussian-like falloff
        // toward the edges (centre matters more than corners).
        for (int i = 0; i < 4; ++i)
        {
            for (int j = 0; j < 4; ++j)
            {
                vec2 sUV = (vec2(float(i), float(j)) + 0.5) * 0.25;
                vec3 s = omw_GetLastShader(sUV).rgb;
                lum += dot(s, vec3(0.2126, 0.7152, 0.0722));
            }
        }
        lum /= 16.0;
        lum = max(lum, 0.001);

        float exposure = uEyeAdaptationTarget / lum;
        exposure = clamp(exposure, uEyeAdaptationMin, uEyeAdaptationMax);
        return col * mix(1.0, exposure, uEyeAdaptationStrength);
    }

    // -------------------------------------------------------------------
    // Volumetric fog 3D (height-modulated, sun-scattered)
    // -------------------------------------------------------------------
    // Raymarches through the view ray and integrates Beer-Lambert extinction
    // against an exponential height-fog density. At each step we evaluate
    // an in-scattering term using the Henyey-Greenstein phase function with
    // the sun direction, so the fog is brighter when looking toward the sun
    // (god-ray-like volumetric haze independent of geometry occlusion).
    vec3 volumetricFog(vec3 col, vec2 uv)
    {
        if (!uVolumetricFog) return col;

        vec3 worldPos = omw_GetWorldPosFromUV(uv);
        vec3 eye = omw.eyePos.xyz;
        vec3 dir = worldPos - eye;
        float dist = length(dir);
        if (dist < 1.0) return col;
        dir /= dist;

        // Don't march further than the visible surface, but cap so we don't
        // do thousands of steps in a far skybox.
        float maxLen = min(dist, 12000.0);
        int steps = uVolumetricFogSteps;
        float stepLen = maxLen / float(steps);

        vec3 sunWS = normalize(omw.sunPos.xyz);
        vec3 sunCol = omw.sunColor.rgb;

        // Henyey-Greenstein phase: g = 0.5 favours mild forward scattering.
        float g = uVolumetricFogScattering;
        float cosTheta = dot(dir, sunWS);
        float hg = (1.0 - g * g) /
                   (4.0 * 3.14159265 * pow(1.0 + g * g - 2.0 * g * cosTheta, 1.5));

        float dither = bayer4x4(gl_FragCoord.xy);
        vec3 inscatter = vec3(0.0);
        float transmittance = 1.0;
        for (int i = 0; i < steps; ++i)
        {
            float t = (float(i) + dither) * stepLen;
            vec3 p = eye + dir * t;
            // Exponential height-fall density (denser near ground).
            float h = max(0.0, p.z - omw.eyePos.z);
            float densityHeight = exp(-uVolumetricFogHeightFalloff * max(p.z, 0.0));
            float density = uVolumetricFogDensity * densityHeight;
            float sigma = density;

            // Local in-scattering: Henyey-Greenstein × sun light × density.
            // Approximate sun visibility as 1 (no shadow march for cost).
            vec3 stepInscat = sunCol * hg * sigma * stepLen * transmittance;
            inscatter += stepInscat;

            // Beer-Lambert extinction along the ray.
            transmittance *= exp(-sigma * stepLen);
            if (transmittance < 0.01) break;
        }

        // Fog colour: warm horizon × density. Mix base scene by transmittance,
        // add inscattering on top.
        return col * transmittance + inscatter;
    }

    // -------------------------------------------------------------------
    // Wet surface effect
    // -------------------------------------------------------------------
    // Tints surfaces facing up with a darkened, more-saturated look and
    // adds a soft sun specular bump. Approximates the "everything's been
    // rained on" feel without needing a per-mesh rain accumulation buffer.
    // Strength is uWetness (0..1) — the user toggles it via F2.
    vec3 applyWetness(vec3 col, vec2 uv)
    {
        if (uWetness <= 0.0) return col;
        vec3 n = omw_GetNormals(uv);
        if (length(n) < 0.5) return col;
        n = normalize(n);

        // Up-mask: surfaces with normal pointing toward camera-up get
        // wetter (water pools there). Convert (0,0,1) world-up into view
        // space and dot with view normal.
        vec3 upVS = (omw.viewMatrix * vec4(0.0, 0.0, 1.0, 0.0)).xyz;
        float upMask = clamp(dot(n, normalize(upVS)), 0.0, 1.0);
        upMask = pow(upMask, 1.5);
        float wet = uWetness * upMask;

        // Darken slightly (water absorbs light a bit) and boost saturation.
        float lum = dot(col, vec3(0.299, 0.587, 0.114));
        vec3 saturated = mix(vec3(lum), col, 1.0 + 0.4 * wet);
        saturated *= mix(1.0, 0.7, wet);

        // Sun specular bump: phong term on the wet-up surface.
        vec3 sunVS = normalize((omw.viewMatrix * vec4(omw.sunPos.xyz, 0.0)).xyz);
        if (sunVS.z < 0.0)
        {
            vec3 viewPos = viewPosFromUV(uv);
            vec3 viewDir = normalize(-viewPos);
            vec3 reflDir = reflect(-sunVS, n);
            float spec = pow(max(dot(reflDir, viewDir), 0.0), 96.0);
            saturated += omw.sunColor.rgb * spec * wet * 1.5;
        }

        return saturated;
    }

    // -------------------------------------------------------------------
    // Volumetric god rays
    // -------------------------------------------------------------------
    // Karras-style screen-space radial scattering: from each pixel we
    // raymarche along the line toward the projected sun position. At each
    // sample we accumulate a contribution that decays with step index, but
    // is killed if the depth at that sample is closer than the far plane
    // (i.e. the sun ray passes through occluding geometry there). The
    // result is the iconic shafts of light through clouds / canopy / windows.
    vec3 godRays(vec2 uv)
    {
        if (!uGodRays) return vec3(0.0);

        // Project sun in clip → screen.
        vec3 sunVS = (omw.viewMatrix * vec4(omw.sunPos.xyz, 0.0)).xyz;
        if (sunVS.z >= 0.0) return vec3(0.0);
        vec4 sunClip = omw_ProjectionMatrix() * vec4(sunVS, 1.0);
        if (sunClip.w <= 0.0) return vec3(0.0);
        vec2 sunUV = sunClip.xy / sunClip.w * 0.5 + 0.5;

        // Underwater path: water acts as a participating medium that scatters
        // light forward, so the shafts are denser, brighter, and visible
        // further from the sun direction than in air.
        bool underwater = uUnderwaterEffects && bool(omw.isUnderwater);

        // GLSL 1.20 has no integer min(); use a ternary instead.
        int boostedSteps = uGodRaysSteps + 24;
        if (boostedSteps > 96) boostedSteps = 96;
        int steps = underwater ? boostedSteps : uGodRaysSteps;
        float decay = underwater ? mix(uGodRaysDecay, 0.99, 0.7) : uGodRaysDecay;
        float intensity = underwater ? (uGodRaysIntensity * 1.8) : uGodRaysIntensity;

        vec2 delta = (sunUV - uv) / float(steps);
        float dither = bayer4x4(gl_FragCoord.xy);
        vec2 sUV = uv + delta * dither;
        float weight = 1.0;
        float accum = 0.0;
        for (int i = 0; i < steps; ++i)
        {
            if (sUV.x < 0.0 || sUV.x > 1.0 || sUV.y < 0.0 || sUV.y > 1.0) break;
            float d = omw_GetDepth(sUV);
            // Sky pixel = unobstructed sun; geometry pixel = block.
#if (OMW_REVERSE_Z == 1)
            float skyContribution = step(d, 0.0001);
#else
            float skyContribution = step(0.99999, d);
#endif
            accum += skyContribution * weight;
            weight *= decay;
            sUV += delta;
        }
        accum /= float(steps);

        // Falloff with screen-distance from the sun so we don't bleed into
        // the corners of the screen unrealistically. Wider underwater.
        float distFromSun = length(uv - sunUV);
        float falloffRate = underwater ? 0.7 : 1.8;
        float radial = exp(-distFromSun * falloffRate);

        // Underwater tint shifts the rays toward cyan/turquoise as the water
        // absorbs red and orange wavelengths preferentially.
        vec3 sunCol = omw.sunColor.rgb;
        if (underwater)
        {
            sunCol = mix(sunCol, vec3(0.45, 0.85, 1.0), 0.65);

            // Add a vertical "shaft" pattern on top of the radial god rays
            // so we see distinct rays descending from the surface even when
            // the sun isn't directly above. Modulated by gradient noise on
            // worldPos so the shafts feel volumetric, not flat.
            vec3 wp = omw_GetWorldPosFromUV(uv);
            float shafts = 0.5 + 0.5 * gradNoise(wp.xy * 0.012 + vec2(omw.simulationTime * 0.05, 0.0));
            shafts *= smoothstep(0.0, 0.6, accum) * 0.6;
            accum = max(accum, shafts);
        }

        return sunCol * accum * radial * intensity;
    }

    // -------------------------------------------------------------------
    // World-space SSR for shiny / metallic surfaces
    // -------------------------------------------------------------------
    // Raymarches the reflection ray of every pixel through the depth
    // buffer; on hit, samples the LastShader (= colour the camera saw at
    // that pixel before our pass). This naturally captures dynamic objects
    // (NPCs, animations) since they're written into LastShader the same
    // frame. We modulate the additive contribution by a "metallic-like"
    // heuristic so flat diffuse surfaces don't get a chrome look:
    //   - bias by surface "smoothness" estimated from local normal variance
    //   - bias by view-luminance (brighter pixels are usually highlights)
    // The user controls strength via uWorldSSRStrength.
    vec4 worldSSR(vec2 uv, vec3 baseColor)
    {
        if (!uWorldSSR) return vec4(0.0);

        vec3 n = omw_GetNormals(uv);
        if (length(n) < 0.5) return vec4(0.0);
        n = normalize(n);

        // Smoothness heuristic: low local variance => smooth (metal/wet),
        // high variance => rough (grass/cloth/skin). Sample 4 neighbours.
        vec2 res = omw.resolution;
        vec2 px = vec2(1.0) / res;
        vec3 nN = omw_GetNormals(uv + vec2(0.0,  px.y));
        vec3 nS = omw_GetNormals(uv - vec2(0.0,  px.y));
        vec3 nE = omw_GetNormals(uv + vec2(px.x, 0.0));
        vec3 nW = omw_GetNormals(uv - vec2(px.x, 0.0));
        float variance = length(n - nN) + length(n - nS) + length(n - nE) + length(n - nW);
        float smoothness = clamp(1.0 - variance * 1.5, 0.0, 1.0);
        if (smoothness < uWorldSSRSmoothness) return vec4(0.0);

        // View-space position from depth.
        vec3 viewPos = viewPosFromUV(uv);
        vec3 viewDir = normalize(viewPos);
        vec3 reflDir = reflect(viewDir, n);

        // Raymarche.
        int steps = uWorldSSRSteps;
        float maxLen = max(50.0, -viewPos.z * 0.4); // proportional to depth
        float stepLen = maxLen / float(steps);
        float dither = bayer4x4(gl_FragCoord.xy);
        vec3 origin = viewPos + n * 0.5; // bias along normal

        vec2 hitUV = vec2(-1.0);
        for (int i = 1; i <= steps; ++i)
        {
            float t = (float(i) + dither) * stepLen;
            vec3 sampleVS = origin + reflDir * t;
            vec4 clip = omw_ProjectionMatrix() * vec4(sampleVS, 1.0);
            if (clip.w <= 0.0) break;
            vec2 sUV = clip.xy / clip.w * 0.5 + 0.5;
            if (sUV.x < 0.0 || sUV.x > 1.0 || sUV.y < 0.0 || sUV.y > 1.0) break;
            float scnDepth = omw_GetLinearDepth(sUV);
            float rayDepth = -sampleVS.z;
            float diff = scnDepth - rayDepth;
            if (diff > 0.0 && diff < stepLen * 1.5)
            {
                hitUV = sUV;
                break;
            }
        }

        if (hitUV.x < 0.0) return vec4(0.0);

        // Edge fade so reflections don't pop at screen borders.
        vec2 edgeFade = vec2(0.5) - abs(hitUV - vec2(0.5));
        float edgeMask = clamp(min(edgeFade.x, edgeFade.y) * 6.0, 0.0, 1.0);

        // Brightness bias: brighter input pixels look more "metallic" with
        // a hint of reflection; avoid lighting up matte dark surfaces.
        float lum = dot(baseColor, vec3(0.299, 0.587, 0.114));
        float brightnessBias = smoothstep(0.15, 0.6, lum);

        vec3 reflectedColor = omw_GetLastShader(hitUV).rgb;
        float strength = smoothness * edgeMask * brightnessBias * uWorldSSRStrength;
        return vec4(reflectedColor, strength);
    }

    void main()
    {
        vec4 col = omw_GetLastShader(omw_TexCoord);

        // Skip the sky / pixels at the far plane (depth at 1 / 0 reverse-Z).
        float d = omw_GetDepth(omw_TexCoord);
#if (OMW_REVERSE_Z == 1)
        bool isSky = d <= 0.0;
#else
        bool isSky = d >= 0.99999;
#endif

        vec3 halo = sunHalo(omw_TexCoord);

        if (isSky)
        {
            vec3 rays = godRays(omw_TexCoord);
            vec3 skyCol = col.rgb;

            // Atmospheric Rayleigh+Mie tint on sky pixels (skipped underwater).
            if (!bool(omw.isUnderwater))
            {
                // Reconstruct world-space view direction from screen UV.
                vec4 ndc = vec4(omw_TexCoord * 2.0 - 1.0, 1.0, 1.0);
                vec4 viewH = omw.invProjectionMatrix * ndc;
                vec3 viewDirVS = normalize(viewH.xyz / viewH.w);
                vec3 viewDirWS = (omw.invViewMatrix * vec4(viewDirVS, 0.0)).xyz;
                vec3 sunDirWS = normalize(omw.sunPos.xyz);

                if (uAtmoScatter)
                {
                    vec3 atmo = atmoSky(viewDirWS, sunDirWS, uAtmoIntensity);
                    // Blend with existing sky so OpenMW weather effects (clouds,
                    // night moons) are not erased. Heavier blend toward zenith.
                    float blend = clamp(viewDirWS.z * 0.7 + 0.3, 0.4, 0.95);
                    skyCol = mix(col.rgb, atmo, blend);
                }
                // Volumetric clouds layered on top of the atmospheric sky.
                skyCol = volumetricClouds(omw_TexCoord, viewDirWS, sunDirWS, skyCol);
            }
            // Underwater fog/tint applies on top (the "sky" seen from below).
            skyCol = applyUnderwater(skyCol, omw_TexCoord);
            omw_FragColor = vec4(skyCol + halo + rays, col.a);
            return;
        }

        float shadow = contactShadow(omw_TexCoord);
        float ao = ambientOcclusion(omw_TexCoord);
        vec4 ssr = worldSSR(omw_TexCoord, col.rgb);
        vec3 rays = godRays(omw_TexCoord);

        // Apply as a multiplicative term on the final image, then add the
        // sun halo + SSR + god rays. Not physically correct but visually
        // convincing for forward-rendered Morrowind scenes.
        vec3 base = col.rgb * shadow * ao;
        base = applyWetness(base, omw_TexCoord);
        // SSR is mixed in additively-with-clamp; the .a holds the strength.
        base = mix(base, max(base, ssr.rgb), ssr.a);
        // Volumetric fog before underwater so the fog stays in air, not
        // doubling up with the underwater scattering tint.
        if (!bool(omw.isUnderwater))
            base = volumetricFog(base, omw_TexCoord);
        // Underwater overlay (caustics + scattering) applied last so it
        // tints everything including SSR/halo contributions.
        base = applyUnderwater(base, omw_TexCoord);
        // Eye adaptation: applied on the fully composited image so the
        // exposure estimate sees the same lighting the player sees.
        base = applyEyeAdaptation(base);
        omw_FragColor = vec4(base + halo + rays, col.a);
    }
}

technique {
    description = "Boosted: contact shadows, SSAO, halo, SSR, wetness, god rays, atmosphere, vol fog/clouds, eye adaptation";
    version = "1.0";
    author = "OpenMW";
    passes = main;
    pass_normals = true;
}
